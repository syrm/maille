#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

apt_packages=(
  bison
  build-essential
  flex
  libicu-dev
  libreadline-dev
  libssl-dev
  uuid-dev
  zlib1g-dev
)
missing_packages=()
for package in "${apt_packages[@]}"; do
  if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -q "ok installed"; then
    missing_packages+=("$package")
  fi
done
if (( ${#missing_packages[@]} > 0 )); then
  echo "Installing native build dependencies"
  sudo apt-get update
  sudo apt-get install -y --no-install-recommends "${missing_packages[@]}"
fi

mise_bin="$HOME/.local/bin/mise"
if [[ ! -x "$mise_bin" ]]; then
  echo "Installing mise"
  curl -fsSL https://mise.run | MISE_INSTALL_PATH="$mise_bin" sh
fi

"$mise_bin" trust "$repo_root/.mise/config.toml"
"$mise_bin" install

echo "Downloading project dependencies"
"$mise_bin" exec -- go mod download
(
  cd frontend
  "$mise_bin" exec -- npm ci
  "$mise_bin" exec -- npm run build
)

pgdata="$repo_root/.amp/postgres"
mkdir -p "$pgdata"
if [[ ! -f "$pgdata/PG_VERSION" ]]; then
  echo "Initializing PostgreSQL"
  "$mise_bin" exec -- initdb -D "$pgdata" --auth=trust --username=maille
fi

started_postgres=false
if ! "$mise_bin" exec -- pg_isready -h 127.0.0.1 -p 15432 -q; then
  "$mise_bin" exec -- pg_ctl -D "$pgdata" -o "-h 127.0.0.1 -p 15432" -w start
  started_postgres=true
fi

if ! "$mise_bin" exec -- psql -h 127.0.0.1 -p 15432 -U maille -d postgres -Atqc \
  "SELECT 1 FROM pg_database WHERE datname = 'maille_orb'" | grep -q 1; then
  "$mise_bin" exec -- createdb -h 127.0.0.1 -p 15432 -U maille maille_orb
fi

if [[ "$started_postgres" == true ]]; then
  "$mise_bin" exec -- pg_ctl -D "$pgdata" -m fast -w stop
fi

echo "Orb setup complete"
